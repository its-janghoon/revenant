    "@types/react-dom": "^19.1.0",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.4.2",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
