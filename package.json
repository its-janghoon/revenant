{
  "name": "revenant",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sandbox": "ampx sandbox",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "test": "node --import tsx --test lib/guard/*.test.ts lib/timeline/*.test.ts lib/broker/*.test.ts",
    "check:local": "cp -n scripts/outputs-stub.json amplify_outputs.json; tsc --noEmit && npm test && RV_KIRO_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111122223333:secret:rv-kiro RV_APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111122223333:secret:rv-app AWS_REGION=us-east-1 next build"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.6.0",
    "@aws-sdk/client-amplify": "^3.800.0",
    "@aws-sdk/client-cloudformation": "^3.800.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.800.0",
    "@aws-sdk/client-codebuild": "^3.800.0",
    "@aws-sdk/client-codecommit": "^3.800.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.800.0",
    "@aws-sdk/client-cost-explorer": "^3.800.0",
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-eventbridge": "^3.800.0",
    "@aws-sdk/client-iam": "^3.800.0",
    "@aws-sdk/client-lambda": "^3.800.0",
    "@aws-sdk/client-rds": "^3.800.0",
    "@aws-sdk/client-rds-data": "^3.800.0",
    "@aws-sdk/client-resource-groups": "^3.1166.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/client-secrets-manager": "^3.800.0",
    "@aws-sdk/client-ssm": "^3.800.0",
    "@aws-sdk/rds-signer": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@aws-sdk/util-dynamodb": "^3.800.0",
    "aws-amplify": "^6.15.0",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
